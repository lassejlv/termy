---
const groups = [
  {
    title: 'Sessions and tabs',
    keys: [
      ['⌘K', 'Change session'],
      ['⇧⌘N', 'New session'],
      ['⌘T', 'New tab'],
      ['⌘1–8', 'Show a tab'],
      ['⌘/', 'Toggle the sidebar'],
    ],
  },
  {
    title: 'Panes',
    keys: [
      ['⌘D', 'Split right'],
      ['⇧⌘D', 'Split down'],
      ['⌘↩', 'Split where it fits best'],
      ['⌥⌘↩', 'Float a pane'],
      ['⇧⌘↩', 'Zoom a pane'],
    ],
  },
  {
    title: 'Getting around',
    keys: [
      ['⇧⌘P', 'Command palette'],
      ['⇧⌘G', 'Go to a directory'],
      ['⌘.', 'Activity'],
      ['⌥⌘←', 'Focus the pane to the left'],
      ['⌃⌘I', 'Insert a path'],
    ],
  },
]
---

<section id="shortcuts" class="mx-auto flex max-w-[1440px] flex-col gap-16 px-6 py-28 md:px-16 xl:pt-[180px] xl:pb-40">
  <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
    <h2 class="text-[32px] leading-[1.12] font-semibold tracking-[-0.025em] md:text-[40px]">Every move has a key.</h2>
    <p class="max-w-[440px] text-[18px] leading-[1.6] text-soft">
      Splits grow in, closed panes shrink away and the tab pill slides along. Reduce Motion turns all of it off.
    </p>
  </div>
  <div class="grid gap-12 md:grid-cols-3">
    {
      groups.map((group) => (
        <div class="flex flex-col gap-5">
          <h3 class="pb-1.5 text-[17px] font-semibold text-[#ff8a73]">{group.title}</h3>
          <dl class="flex flex-col gap-5">
            {group.keys.map(([keys, action]) => (
              <div class="flex items-baseline">
                <dt class="w-[110px] shrink-0 text-[26px] font-semibold">
                  <kbd class="font-sans">{keys}</kbd>
                </dt>
                <dd class="text-[17px] text-soft">{action}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</section>
