---
import { dithers, logos, type Logo } from '@/lib/assets'

const sessions: { name: string; match?: [number, number]; detail: string; logos: Logo[]; selected?: boolean }[] = [
  { name: 'quiet-harbor', match: [6, 9], detail: '2 tabs, detached 3 hours ago', logos: ['node', 'docker'], selected: true },
  { name: 'shy-orchard', detail: '3 tabs, in this window', logos: ['claude', 'codex'] },
  { name: 'late-ember', detail: '1 tab, detached yesterday', logos: ['rust'] },
]
---

<section id="sessions" class="mx-auto flex max-w-[1440px] flex-col gap-12 px-6 py-20 md:px-16 md:py-32 lg:flex-row lg:items-center lg:gap-16">
  <div class="reveal flex shrink-0 flex-col gap-5 lg:w-[440px]">
    <h2 class="text-[32px] leading-[1.1] font-semibold tracking-[-0.03em] text-balance md:text-[44px] md:leading-[48px]">
      Close the window.<br /> Keep the work.
    </h2>
    <p class="text-[17px] leading-[1.6] text-soft md:text-[18px] md:leading-[28px]">
      Your shells run in a Termy session host, not in the app. Closing a window only detaches its session, and quitting
      detaches all of them. Builds, servers and agents carry on without a window.
    </p>
    <div class="flex flex-col gap-2 pt-1 text-[15px] leading-6">
      <p><kbd class="font-sans font-semibold">⌘K</kbd> <span class="text-soft">brings any session back into the window you are in.</span></p>
      <p><kbd class="font-sans font-semibold">⌘W</kbd> <span class="text-soft">on a pane, tab or session is the only thing that ends a program.</span></p>
    </div>
  </div>

  <div class="relative flex h-[400px] min-w-0 grow items-center justify-center overflow-hidden rounded-[22px] bg-panel ring-1 ring-white/6 md:h-[480px]">
    <img src={dithers.stage} alt="" width="832" height="440" class="dither absolute bottom-0 left-0 h-[440px] w-full opacity-[0.32]" />
    <div
      class="relative w-[calc(100%-32px)] max-w-[540px] overflow-hidden rounded-[14px] border border-white/10 bg-popover shadow-[0_24px_64px_rgb(0_0_0/45%)]"
      role="img"
      aria-label="The session picker filtering sessions by 'har', with quiet-harbor selected"
    >
      <div class="flex h-[52px] items-center gap-2.5 border-b border-white/7 px-[18px]">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="#8f8f8f" stroke-width="1.6"></circle><path d="M11 11l3.5 3.5" stroke="#8f8f8f" stroke-width="1.6" stroke-linecap="round"></path></svg>
        <span class="grow text-[16px]">har<span class="caret ml-px inline-block h-[18px] w-px translate-y-[3px] bg-brand"></span></span>
        <span class="text-[13px] text-faint">Change session</span>
      </div>
      <div class="flex flex-col gap-0.5 p-2">
        {
          sessions.map((session) => (
            <div class:list={['flex h-[60px] items-center gap-3 rounded-xl px-3', session.selected && 'bg-brand/15']}>
              <div class="flex min-w-0 grow flex-col">
                <span class="text-[15px] leading-5 font-medium">
                  {session.match ? (
                    <>
                      {session.name.slice(0, session.match[0])}
                      <span class="font-bold text-brand">{session.name.slice(session.match[0], session.match[1])}</span>
                      {session.name.slice(session.match[1])}
                    </>
                  ) : (
                    session.name
                  )}
                </span>
                <span class="truncate text-[13px] leading-[18px] text-[#a8a8a8]">{session.detail}</span>
              </div>
              {session.logos.map((logo) => <img src={logos[logo]} alt="" class="size-4" />)}
              <span class:list={['w-4 text-right text-[13px] text-soft', !session.selected && 'invisible']}>↩</span>
            </div>
          ))
        }
        <div class="flex h-12 items-center px-3">
          <span class="grow text-[15px] text-soft">New session</span>
          <span class="text-[13px] text-faint">⇧⌘N</span>
        </div>
      </div>
    </div>
  </div>
</section>
