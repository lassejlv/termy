---
import { buttonVariants } from '@/components/ui/button'
import { dithers, images } from '@/lib/assets'
import { formatDate, formatSize, type Release } from '@/lib/release'
import AppleLogo from './AppleLogo.astro'

interface Props {
  release: Release
}
const { release } = Astro.props

const facts = [
  `v${release.version}`,
  release.prerelease ? 'pre-release' : 'release',
  formatDate(release.publishedAt),
  formatSize(release.dmg.size),
  'Apple Silicon and Intel',
]
const link = 'text-soft underline decoration-white/25 underline-offset-4 transition-colors hover:text-foreground hover:decoration-white/70'
---

<section id="download" class="mx-auto max-w-[1440px] px-6 pt-8 pb-20 md:px-16 md:pb-32">
  <div class="relative isolate flex min-h-[600px] flex-col items-center overflow-hidden rounded-[20px] bg-panel px-6 pt-16 pb-[220px] text-center ring-1 ring-white/8 md:pt-24">
    <img
      src={dithers.download}
      alt=""
      width="1312"
      height="520"
      class="dither absolute bottom-0 left-1/2 -z-10 h-[520px] w-[1312px] max-w-none -translate-x-1/2 opacity-[0.38]"
    />
    <img src={images.icon} alt="" width="72" height="72" class="mb-7 size-[72px]" />
    <h2 class="reveal text-[32px] leading-[1.1] font-semibold tracking-[-0.03em] text-balance md:text-[40px] md:leading-[44px]">
      Download Termy Next
    </h2>
    <p class="mt-3 text-[16px] leading-6 text-soft">Free, for any Mac on macOS 14 or later</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={release.dmg.url} class={buttonVariants({ variant: 'light', size: 'lg', className: 'h-11 px-5 text-[15px]' })}>
        <AppleLogo class="size-[14px]" />Download for macOS
      </a>
      {
        release.zip && (
          <a href={release.zip.url} class={buttonVariants({ variant: 'secondary', size: 'lg', className: 'h-11 px-5 text-[15px]' })}>
            Download .zip
          </a>
        )
      }
    </div>
    <p class="mt-5 font-mono text-[13px] leading-[18px] text-faint">{facts.join(' · ')}</p>
    <p class="mt-6 max-w-[520px] text-[13px] leading-[1.6] text-faint">
      Open the disk image and drag Termy Next to Applications. Signed and notarized, and kept up to date by Sparkle.{' '}
      {release.checksums && <><a href={release.checksums.url} class={link}>SHA-256 checksums</a>,{' '}</>}
      <a href={release.notesUrl} class={link}>release notes</a>, or build it yourself with{' '}
      <code class="font-mono text-code">just bundle-next</code>.
    </p>
  </div>
</section>
