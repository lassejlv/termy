<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  termy.exe's application manifest: GPUI's own manifest (UAC level, DPI
  awareness, segment heap, common controls 6) plus what the WinUI tab strip
  needs. XAML Islands require maxversiontested, and the Microsoft.UI.Xaml
  classes are registered for unpackaged (registration-free) activation;
  build.rs fills in the <file> element from the package's AppxManifest.

  GPUI links its manifest as a resource and a second one does not link, so
  scripts/windows/embed-manifest.ps1 swaps this in after the build. Without
  it the tab strip falls back to Termy's own drawing.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
    <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
        <security>
            <requestedPrivileges>
                <requestedExecutionLevel level="asInvoker" uiAccess="false" />
            </requestedPrivileges>
        </security>
    </trustInfo>
    <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
        <application>
            <!-- Windows 10 and 11 -->
            <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
            <maxversiontested Id="10.0.22621.0" />
        </application>
    </compatibility>
    <application xmlns="urn:schemas-microsoft-com:asm.v3">
        <windowsSettings>
            <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
            <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
            <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
        </windowsSettings>
    </application>
    <dependency>
        <dependentAssembly>
            <assemblyIdentity
                type="win32"
                name="Microsoft.Windows.Common-Controls"
                version="6.0.0.0"
                processorArchitecture="*"
                publicKeyToken="6595b64144ccf1df"
            />
        </dependentAssembly>
    </dependency>
    <!-- WINUI_ACTIVATABLE_CLASSES -->
</assembly>
