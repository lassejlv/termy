---
const columns = [
  {
    title: 'Termy Next',
    links: [
      ['Download', '#download'],
      ['Sessions', '#sessions'],
      ['Agents', '#agents'],
      ['termy mux', '#termy-mux'],
    ],
  },
  {
    title: 'Termy',
    links: [
      ['termy.sh', 'https://termy.sh'],
      ['Documentation', 'https://termy.sh/docs'],
      ['libtermy', '#libtermy'],
      ['Swift SDK', 'https://github.com/lassejlv/termy/tree/main/sdk/swift'],
    ],
  },
  {
    title: 'Project',
    links: [
      ['GitHub', 'https://github.com/lassejlv/termy'],
      ['Releases', 'https://github.com/lassejlv/termy/releases'],
      ['MIT license', 'https://github.com/lassejlv/termy/blob/main/LICENSE'],
    ],
  },
]
---

<footer class="relative isolate overflow-hidden">
  <img src="/images/sun-footer.webp" alt="" width="1440" height="260" class="pointer-events-none absolute bottom-0 left-1/2 -z-10 w-[1440px] max-w-none -translate-x-1/2 opacity-90" />
  <div class="mx-auto flex max-w-[1440px] flex-col justify-between gap-14 px-6 pt-20 pb-[260px] md:flex-row md:px-16">
    <div class="flex max-w-[360px] flex-col gap-[18px]">
      <a href="/" class="flex items-center gap-3">
        <img src="/images/icon-256.png" alt="" width="28" height="28" class="size-7" />
        <span class="text-[15px] font-semibold">Termy Next</span>
      </a>
      <p class="text-[14px] leading-[1.55] text-muted-foreground">
        A session-first terminal for macOS, built on libtermy. Part of the Termy project.
      </p>
    </div>
    <nav class="grid grid-cols-2 gap-x-16 gap-y-10 sm:grid-cols-3 md:gap-x-24" aria-label="Footer">
      {
        columns.map((column) => (
          <div class="flex flex-col gap-3.5">
            <h2 class="text-[13px] text-faint">{column.title}</h2>
            <ul class="flex flex-col gap-3.5">
              {column.links.map(([label, href]) => (
                <li>
                  <a href={href} class="text-[14px] text-[#e6e0e8] transition-colors hover:text-white">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</footer>
