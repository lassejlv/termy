---
import { buttonVariants } from '@/components/ui/button'
import { images } from '@/lib/assets'

const links = [
  { href: '#sessions', label: 'Sessions' },
  { href: '#agents', label: 'Agents' },
  { href: '#plugins', label: 'Plugins' },
  { href: '/docs', label: 'Docs' },
  { href: 'https://github.com/lassejlv/termy/tree/main/next', label: 'GitHub' },
]
---

<header class="relative z-20 flex h-[72px] items-center justify-between border-b border-white/6 px-6 md:px-16">
  <a href="/" class="flex items-center gap-2.5 rounded-lg">
    <img src={images.icon} alt="" width="24" height="24" class="size-6" />
    <span class="text-[15px] font-semibold">Termy Next</span>
  </a>
  <nav class="flex items-center gap-8" aria-label="Main">
    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-[14px] text-soft transition-colors hover:text-foreground">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="#download" class={buttonVariants({ variant: 'light', size: 'sm', className: 'rounded-lg px-3.5' })}>Download</a>
  </nav>
</header>
