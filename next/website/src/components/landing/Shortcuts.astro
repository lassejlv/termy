---
const groups = [
  {
    title: 'Sessions and tabs',
    keys: [
      ['⌘K', 'Change session'],
      ['⇧⌘N', 'New session'],
      ['⌘T', 'New tab'],
      ['⌘1–8', 'Show a tab'],
      ['⌘/', 'Toggle the sidebar'],
    ],
  },
  {
    title: 'Panes',
    keys: [
      ['⌘D', 'Split right'],
      ['⇧⌘D', 'Split down'],
      ['⌘↩', 'Split where it fits best'],
      ['⌥⌘↩', 'Float a pane'],
      ['⇧⌘↩', 'Zoom a pane'],
    ],
  },
  {
    title: 'Getting around',
    keys: [
      ['⇧⌘P', 'Command palette'],
      ['⇧⌘G', 'Go to a directory'],
      ['⌘.', 'Activity'],
      ['⌥⌘←', 'Focus the pane to the left'],
      ['⌃⌘I', 'Insert a path'],
    ],
  },
]
---

<section id="shortcuts" class="mx-auto flex max-w-[1440px] flex-col gap-10 px-6 py-20 md:px-16 md:py-28">
  <div class="reveal flex flex-col justify-between gap-4 md:flex-row md:items-end">
    <h2 class="text-[24px] leading-[1.2] font-semibold tracking-[-0.02em] text-balance md:text-[28px]">Every move has a key.</h2>
    <p class="max-w-[380px] text-[15px] leading-[1.65] text-soft">
      Splits grow in, closed panes shrink away and the tab pill slides along. Reduce Motion turns all of it off.
    </p>
  </div>
  <div class="grid gap-10 md:grid-cols-3">
    {
      groups.map((group) => (
        <div class="flex flex-col gap-4">
          <h3 class="text-[13px] font-semibold text-brand">{group.title}</h3>
          <dl class="flex flex-col gap-3">
            {group.keys.map(([keys, action]) => (
              <div class="flex items-baseline">
                <dt class="w-[64px] shrink-0 text-[15px] font-semibold">
                  <kbd class="font-sans">{keys}</kbd>
                </dt>
                <dd class="text-[14px] text-soft">{action}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</section>
