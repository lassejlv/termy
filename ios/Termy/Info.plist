<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Scan the pairing QR code shown by Termy Next on your Mac.</string>
	<!-- The Keychain group the app shares its computer list with the widget. -->
	<key>TermyKeychainGroup</key>
	<string>$(AppIdentifierPrefix)sh.termy.shared</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>sh.termy.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>termy</string>
			</array>
		</dict>
	</array>
	<!-- Handoff with Termy Next on the Mac. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>sh.termy.pane</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Speak a command to type into your Mac’s terminal.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turns a command you speak into text you check before it’s typed.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a photo to send to your Mac’s terminal.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects straight to your Mac when both are on the same network.</string>
	<!-- How a Mac is found again on the local network when its address there changed. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_termy._tcp</string>
	</array>
</dict>
</plist>
