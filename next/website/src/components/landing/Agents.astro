---
import { logos, type Logo } from '@/lib/assets'
import WorkingDots from './WorkingDots.astro'

type Row = {
  logo: Logo
  name: string
  state: string
  /** Text color for the state, as a Tailwind class. */
  stateClass: string
  /** The icon's status dot; a working program shows the app's three dots instead. */
  badge?: string
  message: string
  session: string
  highlight?: boolean
  working?: boolean
}

const rows: Row[] = [
  { logo: 'codex', name: 'Codex', state: 'needs permission', stateClass: 'text-blocked', badge: 'bg-blocked', message: 'Run git push origin next', session: 'shy-orchard', highlight: true },
  { logo: 'claude', name: 'Claude Code', state: 'working', stateClass: 'text-brand', message: 'Splitting PaneView', session: 'shy-orchard', working: true },
  { logo: 'claude', name: 'Claude Code', state: 'done', stateClass: 'text-done', badge: 'bg-done', message: 'Wrote the release notes for next-v0.2.0', session: 'quiet-harbor' },
  { logo: 'rust', name: 'cargo build', state: 'error', stateClass: 'text-failed', badge: 'bg-failed', message: '2 errors in termy_ffi', session: 'late-ember' },
]
---

<section id="agents" class="bg-panel">
  <div class="mx-auto flex max-w-[1440px] flex-col-reverse gap-12 px-6 py-20 md:px-16 md:py-32 lg:flex-row lg:items-center lg:gap-24">
    <div
      class="w-full overflow-hidden rounded-[14px] border border-white/9 bg-popover shadow-[0_24px_64px_rgb(0_0_0/40%)] lg:w-[600px] lg:shrink-0"
      role="img"
      aria-label="The Activity popup listing four programs: Codex needs permission, Claude Code working, Claude Code done, cargo build failed"
    >
      <div class="flex h-[52px] items-center justify-between border-b border-white/7 px-[18px]">
        <span class="text-[15px] font-semibold">Activity</span>
        <span class="text-[13px] text-faint">4 programs reporting</span>
      </div>
      <div class="flex flex-col gap-0.5 p-2">
        {
          rows.map((row) => (
            <div class:list={['flex items-center gap-3.5 rounded-xl p-3', row.highlight && 'bg-blocked/10']}>
              <span class="relative size-6 shrink-0">
                <img src={logos[row.logo]} alt="" class="size-6" />
                {row.badge && <span class:list={['absolute -top-0.5 -right-0.5 size-[9px] rounded-full border-2 border-popover', row.badge]} />}
              </span>
              <div class="flex min-w-0 grow flex-col">
                <span class="text-[15px] leading-5 font-semibold">
                  {row.name} <span class:list={['font-medium', row.stateClass]}>{row.state}</span>
                </span>
                <span class="truncate text-[13px] leading-[18px] text-[#a8a8a8]">{row.message}</span>
              </div>
              <span class="hidden w-24 shrink-0 justify-end text-right text-[13px] text-faint sm:flex">
                {row.working ? <WorkingDots /> : row.session}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="reveal flex flex-col gap-5">
      <h2 class="text-[32px] leading-[1.1] font-semibold tracking-[-0.03em] text-balance md:text-[44px] md:leading-[48px]">
        See which agent needs you.
      </h2>
      <p class="max-w-[520px] text-[17px] leading-[1.6] text-soft md:text-[18px] md:leading-[28px]">
        Claude Code, Codex and the rest show up under their own name and logo. Tabs carry their state: dots while
        working, then blue when blocked, green when done, red on an error. Press ⌘. to see every program across every
        session, and click one to jump there.
      </p>
      <p class="max-w-[520px] text-[15px] leading-[1.6] text-faint">
        Status comes from the Program Status Protocol, OSC 7501. Termy Next never guesses from what is on screen.
      </p>
    </div>
  </div>
</section>
