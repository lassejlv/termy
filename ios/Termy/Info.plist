<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Scan the pairing QR code shown by Termy Next on your Mac.</string>
	<!-- The Keychain group the app shares its computer list with the widget. -->
	<key>TermyKeychainGroup</key>
	<string>$(AppIdentifierPrefix)sh.termy.shared</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>sh.termy.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>termy</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- A relay on this Mac or the local network during development. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
