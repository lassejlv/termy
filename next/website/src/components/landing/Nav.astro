---
import { buttonVariants } from '@/components/ui/button'
import { images } from '@/lib/assets'

const links = [
  { href: '#sessions', label: 'Sessions' },
  { href: '#agents', label: 'Agents' },
  { href: '#termy-mux', label: 'termy mux' },
  { href: 'https://github.com/lassejlv/termy/tree/main/next', label: 'GitHub' },
]
---

<header class="relative z-20 flex h-[72px] items-center justify-between px-6 md:px-16">
  <a href="/" class="flex items-center gap-2.5 rounded-lg">
    <img src={images.icon} alt="" width="28" height="28" class="size-7" />
    <span class="text-[15px] font-semibold tracking-[-0.01em]">Termy Next</span>
  </a>
  <nav class="flex items-center gap-6" aria-label="Main">
    <ul class="hidden items-center gap-6 md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-[14px] font-medium text-muted-foreground transition-colors hover:text-foreground">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="#download" class={buttonVariants({ variant: 'secondary', size: 'sm' })}>Download</a>
  </nav>
</header>
